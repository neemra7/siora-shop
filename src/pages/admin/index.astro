---
import "../../styles/global.css";
import { products } from "../../data/product";
---
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8" />
 <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f7f2ea" />
  <link rel="manifest" href="/manifest.webmanifest" />
    <title>لوحة تحكم سيورا آرت</title>
  </head>

  <body class="admin-page">
<script define:vars={{ products }}>
  import { supabase } from "../../lib/supabase";

  document.addEventListener("DOMContentLoaded", async () => {
  const {
    data: { session },
  } = await supabase.auth.getSession();

  if (!session) {
    window.location.href = "/admin/login/";
  }

  const ordersList = document.querySelector<HTMLDivElement>("#orders-list");
  const manualOrderForm = document.querySelector<HTMLFormElement>("#manual-order-form");
  const notificationsButton = document.querySelector<HTMLButtonElement>("#enable-notifications");

  const urlBase64ToUint8Array = (value: string) => {
    const padding = "=".repeat((4 - (value.length % 4)) % 4);
    const base64 = (value + padding).replace(/-/g, "+").replace(/_/g, "/");
    return Uint8Array.from(window.atob(base64), (character) => character.charCodeAt(0));
  };

  const vapidPublicKey = import.meta.env.PUBLIC_VAPID_PUBLIC_KEY;

  notificationsButton?.addEventListener("click", async () => {
    if (!session || !vapidPublicKey || !("serviceWorker" in navigator) || !("PushManager" in window)) {
      return;
    }

    const permission = await Notification.requestPermission();
    if (permission !== "granted") return;

    const registration = await navigator.serviceWorker.register("/sw.js");
    const subscription = await registration.pushManager.subscribe({
      userVisibleOnly: true,
      applicationServerKey: urlBase64ToUint8Array(vapidPublicKey),
    });

    const { error } = await supabase.from("push_subscriptions").upsert({
      user_id: session.user.id,
      endpoint: subscription.endpoint,
      subscription: subscription.toJSON(),
    }, { onConflict: "endpoint" });

    if (!error) notificationsButton.textContent = "الإشعارات مفعلة";
  });
  const statusLabels = {
    new: "جديد",
    processing: "قيد التجهيز",
    completed: "مكتمل",
    cancelled: "ملغي",
  };
   const statusOptions = Object.entries(statusLabels)
     .map(([value, label]) => `<option value="${value}">${label}</option>`)
     .join("");

  const formatDate = (value: string) =>
    new Intl.DateTimeFormat("ar-JO", {
      dateStyle: "medium",
      timeStyle: "short",
    }).format(new Date(value));

  const escapeHtml = (value: string) =>
    value.replace(/[&<>'"]/g, (character) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      "'": "&#39;",
      '"': "&quot;",
    })[character] || character);

  const getSalesAmount = (order: {
    total: number | null;
    delivery_fee: number | null;
    delivery_method: string | null;
  }) => {
    if (order.status === "cancelled") return 0;
    if (order.delivery_method?.includes("الجامعة الأردنية")) {
      return Number(order.total || 0);
    }

    return Math.max(
      0,
      Number(order.total || 0) - Number(order.delivery_fee || 0)
    );
  };

  const updateManualSubtotal = () => {
    if (!manualOrderForm) return;
    const selectedProductIds = Array.from(
      manualOrderForm.querySelectorAll<HTMLInputElement>("[name='product_id']:checked")
    ).map((input) => input.value);
    const subtotal = selectedProductIds.reduce((sum, id) => {
      const product = products.find((item) => item.id === id);
      const quantity = Number(
        manualOrderForm.querySelector<HTMLInputElement>(`[name='quantity-${id}']`)?.value || 0
      );
      return sum + (product?.price || 0) * quantity;
    }, 0);
    const output = document.querySelector<HTMLOutputElement>("#manual-order-subtotal");
    if (output) output.value = `${subtotal.toFixed(2)} د.أ`;
  };

  manualOrderForm?.addEventListener("input", updateManualSubtotal);

  if (ordersList && session) {
    const { data: orders, error } = await supabase
      .from("orders")
      .select("id, customer_name, total, delivery_fee, delivery_method, status, created_at")
      .order("created_at", { ascending: false });

    if (error) {
      console.error("Supabase orders error:", error);
      ordersList.innerHTML =
        '<p class="orders-message">تعذر تحميل الطلبات. تحققي من صلاحيات جدول orders في Supabase.</p>';
    } else {
      const currentOrders = orders || [];
      const monthStart = new Date();
      monthStart.setDate(1);
      monthStart.setHours(0, 0, 0, 0);
      const monthOrders = currentOrders.filter(
        (order) => new Date(order.created_at) >= monthStart
      );
      const newOrders = currentOrders.filter((order) => order.status === "new");
      const processingOrders = currentOrders.filter(
        (order) => order.status === "processing"
      );
      const monthlySales = monthOrders.reduce(
        (sum, order) => {
          return sum + getSalesAmount(order);
        },
        0
      );

      document.querySelector("[data-stat-new]")!.textContent = String(newOrders.length);
      document.querySelector("[data-stat-processing]")!.textContent = String(processingOrders.length);
      document.querySelector("[data-stat-month-orders]")!.textContent = String(monthOrders.length);
      document.querySelector("[data-stat-sales]")!.textContent = `${monthlySales.toFixed(2)} د.أ`;

      if (currentOrders.length === 0) {
      ordersList.innerHTML =
        '<p class="orders-message">لا توجد طلبات حتى الآن.</p>';
      } else {
      ordersList.innerHTML = orders.map((order) => {
        const status = order.status in statusLabels ? order.status : "new";
        const label = statusLabels[status as keyof typeof statusLabels];
        return `
          <article class="order-card">
            <div class="order-main">
              <div class="order-number"><span>طلب</span><strong>#${order.id.slice(0, 8).toUpperCase()}</strong></div>
              <div class="order-customer"><strong>${escapeHtml(order.customer_name || "بدون اسم")}</strong><span>${formatDate(order.created_at)}</span></div>
                <div class="order-status">
                  <select class="order-status-select status-${status}" data-order-status="${order.id}" aria-label="تغيير حالة الطلب">
                    ${statusOptions.replace(`value="${status}"`, `value="${status}" selected`)}
                  </select>
                </div>
              <strong class="order-total">${Number(order.total || 0).toFixed(2)} د.أ</strong>
              <button class="view-order" type="button">عرض الطلب <span>←</span></button>
            </div>
          </article>`;
      }).join("");
      }
    }
  }

  manualOrderForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!session) return;

    const formData = new FormData(manualOrderForm);
    const customerName = String(formData.get("customer_name") || "").trim();
    const selectedProductIds = formData.getAll("product_id").map(String);
    const items = selectedProductIds.flatMap((id) => {
      const product = products.find((item) => item.id === id);
      const quantity = Number(formData.get(`quantity-${id}`) || 0);
      return product && quantity > 0
        ? [{ product_id: product.id, name: product.name, quantity, unit_price: product.price }]
        : [];
    });
    const total = items.reduce((sum, item) => sum + item.unit_price * item.quantity, 0);
    const deliveryFee = Number(formData.get("delivery_fee") || 0);
    const deliveryMethod = String(formData.get("delivery_method") || "").trim();
    const effectiveDeliveryFee = deliveryMethod === "استلام من الجامعة الأردنية" ? 0 : deliveryFee;
    const notes = String(formData.get("notes") || "").trim();
    const message = document.querySelector<HTMLParagraphElement>("#manual-order-message");

    if (!customerName || items.length === 0 || !Number.isFinite(deliveryFee) || deliveryFee < 0) {
      if (message) message.textContent = "أضيفي الاسم ومنتجًا واحدًا على الأقل، وتحققي من رسوم التوصيل.";
      return;
    }

    const { error } = await supabase.from("orders").insert({
      customer_name: customerName,
      delivery_method: deliveryMethod,
      delivery_fee: effectiveDeliveryFee,
      notes: notes || null,
      items,
      total: total + effectiveDeliveryFee,
      status: "new",
    });

    if (error) {

  ordersList?.addEventListener("change", async (event) => {
    const target = event.target;
    if (!(target instanceof HTMLSelectElement) || !target.dataset.orderStatus) return;

    target.disabled = true;
    const { error } = await supabase
      .from("orders")
      .update({ status: target.value })
      .eq("id", target.dataset.orderStatus);

    if (error) {
      console.error("Order status update error:", error);
      target.disabled = false;
      return;
    }

    window.location.reload();
  });
      console.error("Manual order error:", error);
      if (message) message.textContent = "تعذر إضافة الطلب. تحققي من إعدادات Supabase.";
      return;
    }

    window.location.reload();
  });
  });
</script>
<main class="admin-shell">

      <header class="admin-header">
        <div>
          <p class="admin-kicker">سيورا آرت</p>
          <h1>لوحة الطلبات</h1>
        </div>

        <div class="admin-profile">
          <button id="enable-notifications" class="filter-button" type="button">
            تفعيل الإشعارات
          </button>
          <span class="profile-avatar">س</span>
          <span>صاحبة المتجر</span>
        </div>
      </header>

      <section class="stats-grid">

        <article class="stat-card">
          <span>الطلبات الجديدة</span>
          <strong data-stat-new>0</strong>
          <small>تحتاج إلى مراجعة</small>
        </article>

        <article class="stat-card">
          <span>قيد التجهيز</span>
          <strong data-stat-processing>0</strong>
          <small>طلبات حالية</small>
        </article>

        <article class="stat-card">
          <span>طلبات هذا الشهر</span>
          <strong data-stat-month-orders>0</strong>
          <small>حتى الآن</small>
        </article>

        <article class="stat-card">
          <span>المبيعات</span>
          <strong data-stat-sales>0.00 د.أ</strong>
          <small>صافي المنتجات، مع احتساب استلام الجامعة</small>
        </article>

      </section>

      <section class="orders-section">

        <div class="section-heading">
          <div>
            <p>آخر الطلبات</p>
            <h2>طلبات العملاء</h2>
          </div>

          <button class="filter-button">
            جميع الطلبات
            <span>⌄</span>
          </button>
        </div>

        <div id="orders-list" class="orders-list" aria-live="polite">









          <p class="orders-message">جاري تحميل الطلبات...</p>
        </div>

      </section>

      <section class="manual-order-section">
        <div class="section-heading">
          <div>
            <p>إضافة مباشرة</p>
            <h2>إضافة طلب يدوي</h2>
          </div>
        </div>

        <form id="manual-order-form" class="manual-order-form">
          <label>
            اسم العميل
            <input name="customer_name" required />
          </label>
          <label>
            طريقة الاستلام
            <select name="delivery_method" required>
              <option value="استلام من الجامعة الأردنية">استلام من الجامعة الأردنية</option>
              <option value="توصيل">توصيل</option>
            </select>
          </label>
          <fieldset class="manual-products">
            <legend>المنتجات</legend>
            {products.map((product) => (
              <label class="manual-product">
                <span>
                  <input type="checkbox" name="product_id" value={product.id} />
                  {product.name} ({product.price} د.أ)
                </span>
                <input
                  name={`quantity-${product.id}`}
                  type="number"
                  min="1"
                  step="1"
                  value="1"
                  aria-label={`كمية ${product.name}`}
                />
              </label>
            ))}
          </fieldset>
          <output id="manual-order-subtotal" class="manual-order-subtotal">0.00 د.أ</output>
          <label>
            رسوم التوصيل
            <input name="delivery_fee" type="number" min="0" step="0.01" value="0" />
          </label>
          <label class="manual-order-notes">
            ملاحظات
            <input name="notes" />
          </label>
          <button class="filter-button manual-order-submit" type="submit">حفظ الطلب</button>
          <p id="manual-order-message" class="orders-message" aria-live="polite"></p>
        </form>
      </section>

    </main>
  </body>
</html>
  <style>
    .admin-page {
      min-height: 100vh;
      background: #f7f2ea;
    }

    .admin-shell {
      width: min(1200px, calc(100% - 40px));
      margin: 0 auto;
      padding: 40px 0 80px;
    }

    .admin-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 40px;
    }

  .admin-kicker {
    margin: 0 0 6px;
    font-size: 13px;
    letter-spacing: 0.08em;
  }

  .admin-header h1 {
    margin: 0;
    font-size: clamp(30px, 5vw, 48px);
  }

  .admin-profile {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .profile-avatar {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #222;
    color: white;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 50px;
  }

  .stat-card {
    padding: 24px;
    background: white;
    border: 1px solid #e7dfd4;
    border-radius: 18px;
  }

  .stat-card span,
  .stat-card small {
    display: block;
  }

  .stat-card span {
    font-size: 14px;
  }

  .stat-card strong {
    display: block;
    margin: 12px 0 6px;
    font-size: 30px;
  }

  .stat-card small {
    color: #777;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 20px;
  }

  .section-heading p {
    margin: 0 0 5px;
    color: #777;
  }

  .section-heading h2 {
    margin: 0;
    font-size: 28px;
  }

  .filter-button {
    padding: 10px 16px;
    border: 1px solid #ddd3c7;
    border-radius: 999px;
    background: white;
    cursor: pointer;
  }

  .orders-list {
    display: grid;
    gap: 12px;
  }

  .manual-order-section {
    margin-bottom: 50px;
  }

  .manual-order-form {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    padding: 24px;
    background: white;
    border: 1px solid #e7dfd4;
    border-radius: 18px;
  }

  .manual-order-form label {
    display: grid;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
  }

  .manual-products {
    display: grid;
    grid-column: span 4;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .manual-products legend {
    grid-column: 1 / -1;
    font-size: 13px;
    font-weight: 600;
  }

  .manual-product {
    display: flex !important;
    grid-template-columns: 1fr auto;
    align-items: center;
    justify-content: space-between;
    gap: 8px !important;
    padding: 10px;
    border: 1px solid #e7dfd4;
    font-weight: 400 !important;
  }

  .manual-product span {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .manual-product input[type="number"] {
    width: 58px;
  }

  .manual-order-subtotal {
    align-self: end;
    font-weight: 700;
  }

  .manual-order-form input,
  .manual-order-form select {
    min-width: 0;
    padding: 11px 12px;
    border: 1px solid #ddd3c7;
    background: #fffdf9;
    font: inherit;
  }

  .manual-order-notes {
    grid-column: span 2;
  }

  .manual-order-submit {
    align-self: end;
  }

  .order-card {
    background: white;
    border: 1px solid #e7dfd4;
    border-radius: 18px;
    overflow: hidden;
  }

  .order-main {
    display: grid;
    grid-template-columns: 120px 1fr 150px 120px 130px;
    align-items: center;
    gap: 20px;
    padding: 20px;
  }

  .order-number span,
  .order-customer span {
    display: block;
    color: #888;
    font-size: 13px;
  }

  .order-number strong {
    font-size: 20px;
  }

  .order-customer strong {
    display: block;
    margin-bottom: 4px;
  }

  .status {
    display: inline-block;
    padding: 7px 12px;
    border-radius: 999px;
    font-size: 13px;
    background: #eee;
  }

  .status-new {
    background: #f3dfb4;
  }

  .status-processing {
    background: #dce8ef;
  }

  .status-completed {
    background: #dcebdc;
  }

  .status-cancelled {
    background: #f1d6d2;
  }

  .order-status-select {
    padding: 7px 12px;
    border: 0;
    border-radius: 999px;
    color: #1f1b17;
    font: inherit;
    cursor: pointer;
  }

  .order-total {
    text-align: left;
  }

  .view-order {
    border: 0;
    background: transparent;
    cursor: pointer;
    font-weight: 600;
  }

  @media (max-width: 800px) {
    .manual-order-form {
      grid-template-columns: repeat(2, 1fr);
    }

    .manual-products {
      grid-column: span 2;
      grid-template-columns: repeat(2, 1fr);
    }

    .manual-order-notes {
      grid-column: span 2;
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .order-main {
      grid-template-columns: 1fr 1fr;
    }

    .order-total {
      text-align: right;
    }
  }

  @media (max-width: 500px) {
    .admin-shell {
      width: min(100% - 24px, 1200px);
      padding-top: 24px;
    }

    .admin-header {
      align-items: flex-start;
    }

    .admin-profile span:last-child {
      display: none;
    }

    .stats-grid {
      gap: 10px;
    }

    .stat-card {
      padding: 18px;
    }

    .stat-card strong {
      font-size: 24px;
    }

    .section-heading {
      align-items: flex-start;
      gap: 15px;
    }

    .order-main {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .manual-order-form {
      grid-template-columns: 1fr;
      padding: 18px;
    }

    .manual-order-notes {
      grid-column: auto;
    }

    .manual-products {
      grid-column: auto;
      grid-template-columns: 1fr;
    }
  }
</style>
