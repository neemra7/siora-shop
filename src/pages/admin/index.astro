---
import "../../styles/global.css";
import { products } from "../../data/product";
---
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8" />
 <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f7f2ea" />
  <link rel="manifest" href="/manifest.webmanifest" />
    <title>لوحة تحكم سيورا آرت</title>
  </head>

  <body class="admin-page">
<script define:vars={{ products }} lang="ts">
  import { supabase } from "../../lib/supabase";

  (async () => {
    const { data: { session } } = await supabase.auth.getSession();

    const ordersList = document.querySelector<HTMLDivElement>("#orders-list");
    const manualOrderForm = document.querySelector<HTMLFormElement>("#manual-order-form");
    const message = document.querySelector<HTMLParagraphElement>("#manual-order-message");
    const statusLabels = { new: "جديد", processing: "قيد التجهيز", completed: "مكتمل", cancelled: "ملغي" };
    const escapeHtml = (value: string) => value.replace(/[&<>'"]/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;" })[character] || character);
    const getSalesAmount = (order: any) => {
      if (order.status === "cancelled") return 0;
      if (order.delivery_method?.includes("الجامعة الأردنية")) return Number(order.total || 0);
      return Math.max(0, Number(order.total || 0) - Number(order.delivery_fee || 0));
    };
    const getManualItem = (id: string) => {
      const product = products.find((item) => item.id === id);
      const quantity = Number(manualOrderForm?.querySelector<HTMLInputElement>(`[name='quantity-${id}']`)?.value || 0);
      const choices: Record<string, string> = {};
      const text: Record<string, string> = {};
      let customizationPrice = 0;
      product?.customization?.groups.forEach((group, groupIndex) => {
        const choice = manualOrderForm?.querySelector<HTMLSelectElement>(`[name='customization-${id}-${groupIndex}']`)?.value || "";
        const textValue = manualOrderForm?.querySelector<HTMLInputElement>(`[name='customization-text-${id}-${groupIndex}']`)?.value || "";
        if (choice) {
          choices[String(groupIndex)] = choice;
          customizationPrice += group.options.find((option) => option.label === choice)?.price || 0;
        }
        if (textValue) text[String(groupIndex)] = textValue;
      });
      return { product, quantity, unit_price: (product?.price || 0) + customizationPrice, customization: { choices, text } };
    };
    const updateSubtotal = () => {
      const selected = Array.from(manualOrderForm?.querySelectorAll<HTMLInputElement>("[name='product_id']:checked") || []);
      const subtotal = selected.reduce((sum, input) => {
        const item = getManualItem(input.value);
        return sum + item.unit_price * item.quantity;
      }, 0);
      const output = document.querySelector<HTMLOutputElement>("#manual-order-subtotal");
      if (output) {
        output.value = `${subtotal.toFixed(2)} د.أ`;
        output.textContent = `${subtotal.toFixed(2)} د.أ`;
      }
    };
    const uploadImage = async (id: string) => {
      const file = manualOrderForm?.querySelector<HTMLInputElement>(`[name='image-${id}']`)?.files?.[0];
      if (!file) return null;
      const extension = file.name.split(".").pop()?.toLowerCase() || "jpg";
      const path = `${crypto.randomUUID()}.${extension}`;
      const { error } = await supabase.storage.from("order-images").upload(path, file, { contentType: file.type, upsert: false });
      if (error) throw error;
      return supabase.storage.from("order-images").getPublicUrl(path).data.publicUrl;
    };

    manualOrderForm?.addEventListener("input", updateSubtotal);
    manualOrderForm?.addEventListener("change", updateSubtotal);
    updateSubtotal();
    manualOrderForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const formData = new FormData(manualOrderForm);
      const customerName = String(formData.get("customer_name") || "").trim();
      const selectedIds = formData.getAll("product_id").map(String);
      const items = selectedIds.map((id) => ({ id, ...getManualItem(id) })).filter((item) => item.product && item.quantity > 0);
      const subtotal = items.reduce((sum, item) => sum + item.unit_price * item.quantity, 0);
      const deliveryMethod = String(formData.get("delivery_method") || "");
      const deliveryFee = deliveryMethod.includes("الجامعة الأردنية") ? 0 : Number(formData.get("delivery_fee") || 0);
      if (!customerName || !items.length || !Number.isFinite(deliveryFee) || deliveryFee < 0) {
        if (message) message.textContent = "أضيفي الاسم والمنتجات وتحققي من رسوم التوصيل.";
        return;
      }
      try {
        const savedItems = await Promise.all(items.map(async (item) => {
          const imageUrl = await uploadImage(item.id);
          return {
            product_id: item.product!.id,
            name: item.product!.name,
            quantity: item.quantity,
            unit_price: item.unit_price,
            customization: { ...item.customization, image_url: imageUrl },
          };
        }));
        const savedOrder = {
          id: crypto.randomUUID(),
          customer_name: customerName,
          delivery_method: deliveryMethod,
          delivery_fee: deliveryFee,
          notes: String(formData.get("notes") || "").trim() || null,
          items: savedItems,
          total: subtotal + deliveryFee,
          status: "new",
          created_at: new Date().toISOString(),
        };
        const { error } = await supabase.from("orders").insert(savedOrder);
        if (error) throw error;
        if (ordersList && savedOrder) {
          const emptyMessage = ordersList.querySelector(".orders-message");
          if (emptyMessage) ordersList.innerHTML = "";
          const imageLinks = (savedOrder.items || [])
            .map((item: any) => item.customization?.image_url)
            .filter(Boolean)
            .map((url: string) => `<a class="order-image-link" href="${escapeHtml(url)}" target="_blank" rel="noreferrer">صورة</a>`)
            .join("");
          ordersList.insertAdjacentHTML("afterbegin", `<article class="order-card"><div class="order-main"><div class="order-number"><span>طلب</span><strong>#${savedOrder.id.slice(0, 8).toUpperCase()}</strong></div><div class="order-customer"><strong>${escapeHtml(savedOrder.customer_name)}</strong><span>الآن</span></div><div class="order-status"><select class="order-status-select status-new" data-order-status="${savedOrder.id}" aria-label="تغيير حالة الطلب">${Object.entries(statusLabels).map(([value, label]) => `<option value="${value}" ${value === "new" ? "selected" : ""}>${label}</option>`).join("")}</select></div><strong class="order-total">${Number(savedOrder.total || 0).toFixed(2)} د.أ</strong>${imageLinks}</div></article>`);
        }
        manualOrderForm.reset();
        updateSubtotal();
        if (message) message.textContent = "تم حفظ الطلب بنجاح.";
      } catch (error) {
        console.error("Manual order save error:", error);
        if (message) message.textContent = "تعذر حفظ الطلب أو الصورة. تحققي من إعدادات Supabase.";
      }
    });

    if (ordersList) {
      const { data: orders, error } = await supabase.from("orders").select("id, customer_name, total, delivery_fee, delivery_method, status, items, created_at").order("created_at", { ascending: false });
      if (error) {
        ordersList.innerHTML = '<p class="orders-message">تعذر تحميل الطلبات.</p>';
      } else {
        const currentOrders = orders || [];
        const monthStart = new Date();
        monthStart.setDate(1);
        monthStart.setHours(0, 0, 0, 0);
        const monthOrders = currentOrders.filter((order) => new Date(order.created_at) >= monthStart);
        document.querySelector("[data-stat-new]")!.textContent = String(currentOrders.filter((order) => order.status === "new").length);
        document.querySelector("[data-stat-processing]")!.textContent = String(currentOrders.filter((order) => order.status === "processing").length);
        document.querySelector("[data-stat-month-orders]")!.textContent = String(monthOrders.length);
        document.querySelector("[data-stat-sales]")!.textContent = `${monthOrders.reduce((sum, order) => sum + getSalesAmount(order), 0).toFixed(2)} د.أ`;
        ordersList.innerHTML = currentOrders.length ? currentOrders.map((order) => {
          const status = order.status in statusLabels ? order.status : "new";
          const images = (order.items || []).map((item: any) => item.customization?.image_url).filter(Boolean).map((url: string) => `<a class="order-image-link" href="${escapeHtml(url)}" target="_blank" rel="noreferrer">صورة</a>`).join("");
          return `<article class="order-card"><div class="order-main"><div class="order-number"><span>طلب</span><strong>#${order.id.slice(0, 8).toUpperCase()}</strong></div><div class="order-customer"><strong>${escapeHtml(order.customer_name || "بدون اسم")}</strong><span>${new Intl.DateTimeFormat("ar-JO", { dateStyle: "medium", timeStyle: "short" }).format(new Date(order.created_at))}</span></div><div class="order-status"><select class="order-status-select status-${status}" data-order-status="${order.id}" aria-label="تغيير حالة الطلب">${Object.entries(statusLabels).map(([value, label]) => `<option value="${value}" ${value === status ? "selected" : ""}>${label}</option>`).join("")}</select></div><strong class="order-total">${Number(order.total || 0).toFixed(2)} د.أ</strong>${images}</div></article>`;
        }).join("") : '<p class="orders-message">لا توجد طلبات حتى الآن.</p>';
      }
    }

    ordersList?.addEventListener("change", async (event) => {
      const target = event.target;
      if (!(target instanceof HTMLSelectElement) || !target.dataset.orderStatus) return;
      target.disabled = true;
      const { error } = await supabase.from("orders").update({ status: target.value }).eq("id", target.dataset.orderStatus);
      if (error) {
        target.disabled = false;
        console.error("Order status update error:", error);
      } else {
        window.location.reload();
      }
    });
  })();
</script>
<main class="admin-shell">

      <header class="admin-header">
        <div>
          <p class="admin-kicker">سيورا آرت</p>
          <h1>لوحة الطلبات</h1>
        </div>

        <div class="admin-profile">
          <button id="enable-notifications" class="filter-button" type="button">
            تفعيل الإشعارات
          </button>
          <span class="profile-avatar">س</span>
          <span>صاحبة المتجر</span>
        </div>
      </header>

      <section class="stats-grid">

        <article class="stat-card">
          <span>الطلبات الجديدة</span>
          <strong data-stat-new>0</strong>
          <small>تحتاج إلى مراجعة</small>
        </article>

        <article class="stat-card">
          <span>قيد التجهيز</span>
          <strong data-stat-processing>0</strong>
          <small>طلبات حالية</small>
        </article>

        <article class="stat-card">
          <span>طلبات هذا الشهر</span>
          <strong data-stat-month-orders>0</strong>
          <small>حتى الآن</small>
        </article>

        <article class="stat-card">
          <span>المبيعات</span>
          <strong data-stat-sales>0.00 د.أ</strong>
          <small>صافي المنتجات، مع احتساب استلام الجامعة</small>
        </article>

      </section>

      <section class="orders-section">

        <div class="section-heading">
          <div>
            <p>آخر الطلبات</p>
            <h2>طلبات العملاء</h2>
          </div>

          <button class="filter-button">
            جميع الطلبات
            <span>⌄</span>
          </button>
        </div>

        <div id="orders-list" class="orders-list" aria-live="polite">









          <p class="orders-message">جاري تحميل الطلبات...</p>
        </div>

      </section>

      <section class="manual-order-section">
        <div class="section-heading">
          <div>
            <p>إضافة مباشرة</p>
            <h2>إضافة طلب يدوي</h2>
          </div>
        </div>

        <form id="manual-order-form" class="manual-order-form">
          <label>
            اسم العميل
            <input name="customer_name" required />
          </label>
          <label>
            طريقة الاستلام
            <select name="delivery_method" required>
              <option value="استلام من الجامعة الأردنية">استلام من الجامعة الأردنية</option>
              <option value="توصيل">توصيل</option>
            </select>
          </label>
          <fieldset class="manual-products">
            <legend>المنتجات</legend>
            {products.map((product) => (
              <label class="manual-product">
                <span>
                  <input type="checkbox" name="product_id" value={product.id} />
                  {product.name} ({product.price} د.أ)
                </span>
                <input
                  name={`quantity-${product.id}`}
                  type="number"
                  min="1"
                  step="1"
                  value="1"
                  aria-label={`كمية ${product.name}`}
                />
                {product.customization?.groups.map((group, groupIndex) => (
                  <span class="manual-customization">
                    {group.options.length > 0 ? (
                      <select name={`customization-${product.id}-${groupIndex}`} aria-label={`${product.name}: ${group.label}`}>
                        <option value="">{group.label}</option>
                        {group.options.map((option) => (
                          <option value={option.label}>
                            {option.label}{option.price ? ` (+${option.price} د.أ)` : ""}
                          </option>
                        ))}
                      </select>
                    ) : null}
                    {group.textInput ? (
                      <input
                        name={`customization-text-${product.id}-${groupIndex}`}
                        placeholder={group.textInput.placeholder}
                        aria-label={`${product.name}: ${group.label}`}
                      />
                    ) : null}
                  </span>
                ))}
                {product.customization?.imageUpload ? (
                  <span class="manual-customization">
                    <input
                      name={`image-${product.id}`}
                      type="file"
                      accept="image/*"
                      aria-label={`صورة ${product.name}`}
                    />
                  </span>
                ) : null}
              </label>
            ))}
          </fieldset>
          <output id="manual-order-subtotal" class="manual-order-subtotal">0.00 د.أ</output>
          <label>
            رسوم التوصيل
            <input name="delivery_fee" type="number" min="0" step="0.01" value="0" />
          </label>
          <label class="manual-order-notes">
            ملاحظات
            <input name="notes" />
          </label>
          <button class="filter-button manual-order-submit" type="submit">حفظ الطلب</button>
          <p id="manual-order-message" class="orders-message" aria-live="polite"></p>
        </form>
      </section>

    </main>
  </body>
</html>
  <style>
    .admin-page {
      min-height: 100vh;
      background: #f7f2ea;
    }

    .admin-shell {
      width: min(1200px, calc(100% - 40px));
      margin: 0 auto;
      padding: 40px 0 80px;
    }

    .admin-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 40px;
    }

  .admin-kicker {
    margin: 0 0 6px;
    font-size: 13px;
    letter-spacing: 0.08em;
  }

  .admin-header h1 {
    margin: 0;
    font-size: clamp(30px, 5vw, 48px);
  }

  .admin-profile {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .profile-avatar {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #222;
    color: white;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 50px;
  }

  .stat-card {
    padding: 24px;
    background: white;
    border: 1px solid #e7dfd4;
    border-radius: 18px;
  }

  .stat-card span,
  .stat-card small {
    display: block;
  }

  .stat-card span {
    font-size: 14px;
  }

  .stat-card strong {
    display: block;
    margin: 12px 0 6px;
    font-size: 30px;
  }

  .stat-card small {
    color: #777;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 20px;
  }

  .section-heading p {
    margin: 0 0 5px;
    color: #777;
  }

  .section-heading h2 {
    margin: 0;
    font-size: 28px;
  }

  .filter-button {
    padding: 10px 16px;
    border: 1px solid #ddd3c7;
    border-radius: 999px;
    background: white;
    cursor: pointer;
  }

  .orders-list {
    display: grid;
    gap: 12px;
  }

  .manual-order-section {
    margin-bottom: 50px;
  }

  .manual-order-form {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    padding: 24px;
    background: white;
    border: 1px solid #e7dfd4;
    border-radius: 18px;
  }

  .manual-order-form label {
    display: grid;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
  }

  .manual-products {
    display: grid;
    grid-column: span 4;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .manual-products legend {
    grid-column: 1 / -1;
    font-size: 13px;
    font-weight: 600;
  }

  .manual-product {
    display: grid !important;
    grid-template-columns: 1fr auto;
    align-items: start;
    justify-content: initial;
    gap: 8px !important;
    padding: 10px;
    border: 1px solid #e7dfd4;
    font-weight: 400 !important;
  }

  .manual-product span {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .manual-product input[type="number"] {
    width: 58px;
  }

  .manual-customization {
    display: grid !important;
    grid-column: 1 / -1;
    gap: 6px !important;
    font-size: 12px;
  }

  .manual-customization select,
  .manual-customization input {
    width: 100%;
    box-sizing: border-box;
    padding: 8px;
    border: 1px solid #ddd3c7;
    background: #fffdf9;
    font: inherit;
  }

  .manual-order-subtotal {
    align-self: end;
    font-weight: 700;
  }

  .manual-order-form input,
  .manual-order-form select {
    min-width: 0;
    padding: 11px 12px;
    border: 1px solid #ddd3c7;
    background: #fffdf9;
    font: inherit;
  }

  .manual-order-notes {
    grid-column: span 2;
  }

  .manual-order-submit {
    align-self: end;
  }

  .order-card {
    background: white;
    border: 1px solid #e7dfd4;
    border-radius: 18px;
    overflow: hidden;
  }

  .order-main {
    display: grid;
    grid-template-columns: 120px 1fr 150px 120px 130px;
    align-items: center;
    gap: 20px;
    padding: 20px;
  }

  .order-number span,
  .order-customer span {
    display: block;
    color: #888;
    font-size: 13px;
  }

  .order-number strong {
    font-size: 20px;
  }

  .order-customer strong {
    display: block;
    margin-bottom: 4px;
  }

  .status {
    display: inline-block;
    padding: 7px 12px;
    border-radius: 999px;
    font-size: 13px;
    background: #eee;
  }

  .status-new {
    background: #f3dfb4;
  }

  .status-processing {
    background: #dce8ef;
  }

  .status-completed {
    background: #dcebdc;
  }

  .status-cancelled {
    background: #f1d6d2;
  }

  .order-status-select {
    padding: 7px 12px;
    border: 0;
    border-radius: 999px;
    color: #1f1b17;
    font: inherit;
    cursor: pointer;
  }

  .order-total {
    text-align: left;
  }

  .view-order {
    border: 0;
    background: transparent;
    cursor: pointer;
    font-weight: 600;
  }

  @media (max-width: 800px) {
    .manual-order-form {
      grid-template-columns: repeat(2, 1fr);
    }

    .manual-products {
      grid-column: span 2;
      grid-template-columns: repeat(2, 1fr);
    }

    .manual-order-notes {
      grid-column: span 2;
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .order-main {
      grid-template-columns: 1fr 1fr;
    }

    .order-total {
      text-align: right;
    }
  }

  @media (max-width: 500px) {
    .admin-shell {
      width: min(100% - 24px, 1200px);
      padding-top: 24px;
    }

    .admin-header {
      align-items: flex-start;
    }

    .admin-profile span:last-child {
      display: none;
    }

    .stats-grid {
      gap: 10px;
    }

    .stat-card {
      padding: 18px;
    }

    .stat-card strong {
      font-size: 24px;
    }

    .section-heading {
      align-items: flex-start;
      gap: 15px;
    }

    .order-main {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .manual-order-form {
      grid-template-columns: 1fr;
      padding: 18px;
    }

    .manual-order-notes {
      grid-column: auto;
    }

    .manual-products {
      grid-column: auto;
      grid-template-columns: 1fr;
    }
  }
</style>
